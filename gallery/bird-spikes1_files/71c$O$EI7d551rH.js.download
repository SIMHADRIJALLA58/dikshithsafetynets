window.aui.amd_define("@amzn/flow.component.star-rating-shared-components",["@amzn/kata-web-framework-runtime-functions","@amzn/aui-styles","@amzn/flow.device-capabilities-kata-functions","@amzn/kata-web-framework-register","@amzn/kata-web-framework-runtime-utils","@amzn/aui-styles.runtime"],(function(e,n,i,o,r,t){"use strict";function a(e){return"ಉತ್ಪನ್ನ ಸ್ಟಾರ್ ರೇಟಿಂಗ್‌ಗಳು ಸೇರಿದಂತೆ ಗ್ರಾಹಕ ವಿಮರ್ಶೆಗಳು ಗ್ರಾಹಕರಿಗೆ ಉತ್ಪನ್ನದ ಬಗ್ಗೆ ಇನ್ನಷ್ಟು ತಿಳಿದುಕೊಳ್ಳಲು ಮತ್ತು ಅವರಿಗೆ ಸರಿಯಾದ ಉತ್ಪನ್ನವಾಗಿದೆಯೇ ಎಂದು ನಿರ್ಧರಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ."}function d(e){return"ಒಟ್ಟಾರೆ ಸ್ಟಾರ್ ರೇಟಿಂಗ್ ಮತ್ತು ಸ್ಟಾರ್‌ ಪ್ರಕಾರ ಶೇಕಡಾವಾರು ಬ್ರೇಕ್‌ಡೌನ್ ಅನ್ನು ಲೆಕ್ಕಾಚಾರ ಮಾಡಲು, ನಾವು ಸರಳ ಸರಾಸರಿ ಬಳಸುವುದಿಲ್ಲ. ಬದಲಾಗಿ, ನಮ್ಮ ವ್ಯವಸ್ಥೆಯು ವಿಮರ್ಶೆಯು ಎಷ್ಟು ಇತ್ತೀಚಿನದು ಮತ್ತು ವಿಮರ್ಶಕ Amazon ನಲ್ಲಿ ಐಟಂ ಅನ್ನು ಖರೀದಿಸಿದ್ದಾರೆಯೆ ಮುಂತಾದ ವಿಷಯಗಳನ್ನು ಪರಿಗಣಿಸುತ್ತದೆ. ಇದು ವಿಶ್ವಾಸಾರ್ಹತೆಯನ್ನು ಪರಿಶೀಲಿಸಲು ವಿಮರ್ಶೆಗಳನ್ನು ಸಹ ವಿಶ್ಲೇಷಿಸಿದೆ."}function s(e){return"Amazon ನಲ್ಲಿ ಗ್ರಾಹಕ ವಿಮರ್ಶೆಗಳು ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ ಎಂಬುದನ್ನು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ"}function u(e){return"ಗ್ರಾಹಕ ವಿಮರ್ಶೆಗಳು ಮತ್ತು ರೇಟಿಂಗ್‌ಗಳು ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ"}function c(e,n,i){return n+" ಸ್ಟಾರ್‌ಗಳು "+i+"% ರೇಟಿಂಗ್ ಅನ್ನು ಪ್ರತಿನಿಧಿಸುತ್ತವೆ"}function l(e,n){return"1 ಸ್ಟಾರ್ "+n+"% ರೇಟಿಂಗ್ ಅನ್ನು ಪ್ರತಿನಿಧಿಸುತ್ತದೆ"}function v(e){return"Klantenrecensies, inclusief sterbeoordelingen voor producten, geven klanten meer informatie over het product en geeft ze de mogelijkheid te beslissen of het voor hen het juiste product is."}function m(e){return"Voor het berekenen van de totale sterbeoordeling en de procentuele verdeling per ster gebruiken we geen gewoon gemiddelde. In plaats daarvan houdt ons systeem rekening met zaken als hoe recent een recensie is en of de beoordelaar het item op Amazon heeft gekocht. Het systeem heeft ook recensies geanalyseerd om de betrouwbaarheid te verifiëren."}function f(e){return"Meer informatie over hoe klantenrecensies werken op Amazon"}function p(e){return"Hoe klantenrecensies en -beoordelingen werken"}function b(e,n,i){return n+" sterren staat voor "+i+"% van de beoordelingen"}function h(e,n){return"1 ster staat voor "+n+"% van de beoordelingen"}function g(e){return"Las opiniones de los clientes, incluidas las calificaciones de por estrellas de productos, sirven para que otros clientes tengan más información acerca de los productos y decidan si son adecuados para ellos."}function _(e){return"Para calcular la calificación general por estrellas y el desglose porcentual por estrellas, no usamos un promedio simple. En su lugar, nuestro sistema considera cosas como lo reciente que es una opinión y si el revisor compró el producto en Amazon. También se analizan las opiniones para verificar la confiabilidad."}function w(e){return"Más información sobre cómo funcionan las opiniones del cliente en Amazon"}function z(e){return"Cómo funcionan las opiniones y calificaciones de los clientes"}function k(e,n,i){return"Las "+n+" estrellas representan el "+i+"% de la calificación"}function y(e,n){return"1 estrella representa el "+n+" % de la calificación"}function A(e){return"Las opiniones de los clientes, incluidas las valoraciones del producto, ayudan a otros clientes a obtener más información sobre el producto y a decidir si es el adecuado para ellos."}function I(e){return"Para calcular la valoración global en estrellas y el desglose porcentual por estrella, no utilizamos un promedio simple. En su lugar, nuestro sistema considera aspectos como lo reciente que es la reseña y si el autor compró el producto en Amazon. También analiza las reseñas para verificar su fiabilidad."}function j(e){return"Más información sobre cómo funcionan las opiniones de los clientes en Amazon"}function N(e){return"Cómo funcionan las opiniones y las valoraciones de los clientes"}function E(e,n,i){return n+" estrellas representan el "+i+"% de las valoraciones"}function S(e,n){return"1 estrella representa el "+n+"% de las valoraciones"}function P(e){return"Customer reviews, including product star ratings, help customers to learn more about the product and decide whether it is the right product for them."}function x(e){return"To calculate the overall star rating and percentage breakdown by star, we don’t use a simple average. Instead, our system considers things like how recent a review is and if the reviewer bought the item on Amazon. It also analyzed reviews to verify trustworthiness."}function L(e){return"Learn more how customer reviews work on Amazon"}function C(e){return"How customer reviews and ratings work"}function R(e,n,i){return n+" stars represent "+i+"% of ratings"}function T(e,n){return"1 star represents "+n+"% of ratings"}function H(e){return"ഉൽപ്പന്ന സ്‌റ്റാർ റേറ്റിംഗുകൾ ഉൾപ്പെടെയുള്ള ഉപഭോക്തൃ അവലോകനങ്ങൾ ഉൽപ്പന്നത്തെക്കുറിച്ച് കൂടുതലറിയാനും അത് അവർക്ക് അനുയോജ്യമായ ഉൽപ്പന്നമാണോ എന്ന് തീരുമാനിക്കാനും ഉപഭോക്താക്കളെ സഹായിക്കുന്നു."}function B(e){return"മൊത്തത്തിലുള്ള സ്റ്റാർ റേറ്റിംഗും സ്റ്റാർ പ്രകാരമുള്ള ബ്രേക്ക്ഡൗൺ ശതമാനവും കണക്കാക്കാൻ, ഞങ്ങൾ ഒരു ലളിതമായ ശരാശരി ഉപയോഗിക്കുന്നില്ല. പകരം, ഒരു അവലോകനം എത്രത്തോളം പുതിയതാണ്, അവലോകനം നൽകിയ വ്യക്തി ഈ ഉൽപ്പന്നം Amazon-ൽ നിന്നാണോ വാങ്ങിയത് തുടങ്ങിയ കാര്യങ്ങളാണ് ഞങ്ങളുടെ സിസ്റ്റം പരിഗണിക്കുന്നത്. വിശ്വാസ്യത ഉറപ്പുവരുത്തുന്നതിനായി ഇത് അവലോകനങ്ങളെ വിശകലനം ചെയ്യുന്നു."}function O(e){return"Amazon-ൽ ഉപഭോക്തൃ അവലോകനങ്ങൾ എങ്ങനെ പ്രവർത്തിക്കുന്നു എന്നതിനെക്കുറിച്ച് കൂടുതലറിയുക"}function M(e){return"ഉപഭോക്തൃ അവലോകനങ്ങളും റേറ്റിംഗുകളും എങ്ങനെ പ്രവർത്തിക്കുന്നു"}function K(e,n,i){return n+" സ്‌റ്റാറുകൾ "+i+"% റേറ്റിംഗുകളെ പ്രതിനിധീകരിക്കുന്നു"}function U(e,n){return"1 സ്റ്റാർ "+n+"% റേറ്റിംഗുകളെ പ്രതിനിധീകരിക്കുന്നു"}function F(e){return"customer review, including Product star rating help customer to learn more about the product and decide whether it is the right product for them."}function D(e){return"To calculate the overall star rating and percentage breakdown by star, we don’t use a simple average. Instead, our system considers things like how recent a review is and if the reviewer bought the item on Amazon. It also analysed reviews to verify trustworthiness."}function Z(e){return"Learn more how customer reviews work on Amazon"}function G(e){return"How customer review and ratings work"}function J(e,n,i){return n+" stars represent "+i+"% of ratings"}function q(e,n){return"1 star represents "+n+"% of ratings"}function W(e){return"Recenze zákazníků, včetně hodnocení produktu hvězdičkami, pomáhají zákazníkům dozvědět se více o produktu a rozhodnout se, zda je pro ně vhodný."}function V(e){return"Pro výpočet celkového hodnocení hvězdičkami a procentuálního rozdělení podle hvězdiček nepoužíváme prostý průměr. Místo toho náš systém například zvažuje, jak aktuální recenze je a zda recenzent zakoupil položku v obchodě Amazon. Také recenze analyzujeme, abychom ověřili jejich důvěryhodnost."}function X(e){return"Zjistěte více o tom, jak fungují recenze zákazníků na Amazonu"}function Y(e){return"Jak fungují recenze a hodnocení zákazníků"}function Q(e,n,i){return"Počet hvězdiček "+n+" představuje "+i+"% hodnocení"}function $(e,n){return"1 hvězdička představuje "+n+"% hodnocení"}function ee(e){return"Le recensioni dei clienti, comprese le valutazioni dei prodotti, aiutano i clienti ad ottenere maggiori informazioni sul prodotto e a decidere se è il prodotto giusto per loro."}function ne(e){return"Per calcolare la valutazione complessiva e la ripartizione percentuale per stella, non usiamo una semplice media. Il nostro sistema considera invece elementi come quanto è recente una recensione e se il recensore ha acquistato l'articolo su Amazon. In più analizza le recensioni stesse per verificarne l'affidabilità."}function ie(e){return"Scopri di più sul funzionamento delle recensioni dei clienti su Amazon"}function oe(e){return"Come funzionano le recensioni e le valutazioni dei clienti"}function re(e,n,i){return n+" stelle rappresentano il "+i+"% della valutazione"}function te(e,n){return"1 stella rappresenta il "+n+"% delle valutazioni"}function ae(e){return"As avaliações de clientes, inclusive as avaliações por estrelas dos produtos, ajudam os clientes a saber mais sobre o produto e a decidir se é o produto certo para eles."}function de(e){return"Para calcular a avaliação por estrelas geral e a análise percentual por estrela, não usamos uma média simples. Em vez disso, nosso sistema considera coisas como se uma avaliação é recente e se o avaliador comprou o produto na Amazon. Ele também analisa avaliações para verificar a confiabilidade."}function se(e){return"Saiba mais sobre como funcionam as avaliações de clientes na Amazon"}function ue(e){return"Como as avaliações e classificações de clientes funcionam"}function ce(e,n,i){return n+" estrelas representam "+i+"% de classificação"}function le(e,n){return"1 estrela representa "+n+"% das classificações"}function ve(e){return"客戶評論 (包括產品星等評分) 能幫助客戶更了解商品，並評估該商品是否適合自己。"}function me(e){return"若要依星等計算整體星等評分和百分比細分，我們並不會使用簡單的平均值。 相反地，我們的系統會考慮評論日期的遠近，以及評論者是否在 Amazon 購買了該品項等因素。 此系統還會分析評論內容，以驗證可信度。"}function fe(e){return"進一步了解 Amazon 的客戶評論運作方式"}function pe(e){return"客戶評論與評分的運作方式"}function be(e,n,i){return n+" 星等代表 "+i+"% 的評分"}function he(e,n){return"1 星等代表 "+n+"% 的評分"}function ge(e){return"As avaliações de clientes, incluindo as avaliações de produtos por estrelas, ajudam os clientes a obter mais informações sobre o produto e a decidir se é adequado para eles."}function _e(e){return"Para calcular a avaliação por estrelas geral e a repartição percentual por estrelas, não usamos uma média simples. Pelo contrário, o nosso sistema tem em consideração elementos como, por exemplo, se a avaliação é recente e se o avaliador comprou o produto na Amazon. Também analisa as avaliações para verificar a respetiva credibilidade."}function we(e){return"Saiba mais sobre como funcionam as avaliações dos clientes na Amazon"}function ze(e){return"Como funcionam as avaliações de clientes e as classificações"}function ke(e,n,i){return n+" estrelas representam "+i+"% das classificações"}function ye(e,n){return"1 estrela representa "+n+"% das classificações"}function Ae(e){return"客户评论（包括商品星级评定）可帮助客户进一步了解商品，并确定商品是否适合他们。"}function Ie(e){return"计算总星级评分以及各星级所占的百分比时，我们没有简单地取平均值。 相反，我们的系统会考量评论的发表时间，评论者是否在亚马逊上购买了该商品等因素。 系统还对评论进行分析，以验证其可信度。"}function je(e){return"进一步了解亚马逊客户评论机制"}function Ne(e){return"如何统计展示买家评论和评分"}function Ee(e,n,i){return n+" 星级占总评级数的 "+i+"%"}function Se(e,n){return"1 星级占总评级数的 "+n+"%"}function Pe(e){return"Customer review, including product star rating, help customer to learn more about the product and decide whether it is the right product for them."}function xe(e){return"To calculate the overall star rating and percentage breakdown by star, we don’t use a simple average. Instead, our system considers things like how recent a review is and if the reviewer bought the item on Amazon. It also analysed reviews to verify trustworthiness."}function Le(e){return"Learn more how customer reviews work on Amazon"}function Ce(e){return"How customer review and ratings work"}function Re(e,n,i){return n+" stars represent "+i+"% of ratings"}function Te(e,n){return"1 star represents "+n+"% of ratings"}function He(e){return"Ürün Yıldız Puanları dahil olmak üzere Müşteri Yorumları, müşterilerin ürün hakkında daha fazla bilgi edinmesine ve kendileri için doğru ürün olup olmadığına karar vermelerine yardımcı olur."}function Be(e){return"Toplam yıldız puanını ve yıldıza göre yüzde dökümünü hesaplamak için basit bir ortalama kullanmayız. Bunun yerine, sistemimiz bir yorumun ne kadar yeni olduğu ve yorum yapan kullanıcının ürünü Amazon'dan satın alıp almadığı gibi şeyleri değerlendirir. Ayrıca güvenilirliği doğrulamak için yorumları analiz eder."}function Oe(e){return"Amazon'da müşteri yorumlarının nasıl işlediği hakkında daha fazla bilgi alın"}function Me(e){return"Müşteri yorumları ve değerlendirmeleri nasıl çalışır?"}function Ke(e,n,i){return n+" yıldız derecelendirmenin %"+i+" oranını temsil eder"}function Ue(e,n){return"1 yıldız, değerlendirmelerin %"+n+" oranını temsil eder"}function Fe(e){return"Customer Reviews, including Product Star Ratings help customers to learn more about the product and decide whether it is the right product for them."}function De(e){return"To calculate the overall star rating and percentage breakdown by star, we don’t use a simple average. Instead, our system considers things like how recent a review is and if the reviewer bought the item on Amazon. It also analyzed reviews to verify trustworthiness."}function Ze(e){return"Learn more how customer reviews work on Amazon"}function Ge(e){return"How customer reviews and ratings work"}function Je(e,n,i){return n+" stars represent "+i+"% of ratings"}function qe(e,n){return"1 star represents "+n+"% of ratings"}function We(e){return"Customer Reviews, including Product Star Ratings help customers learn more about the product and decide whether it is the right product for them."}function Ve(e){return"To calculate the overall star rating and percentage breakdown by star, we don’t use a simple average. Instead, our system considers things like how recent a review is and if the reviewer bought the item on Amazon. It also analysed reviews to verify trustworthiness."}function Xe(e){return"Learn more how customer reviews work on Amazon"}function Ye(e){return"How customer reviews and ratings work"}function Qe(e,n,i){return n+" stars represent "+i+"% of ratings"}function $e(e,n){return"1 star represents "+n+"% of ratings"}function en(e){return"Les commentaires clients, y compris le nombre d’étoiles du produit, aident les clients à en savoir plus sur le produit et à décider s'il leur convient."}function nn(e){return"Pour calculer l'évaluation globale en nombre d'étoiles et la répartition en pourcentage par étoile, nous n'utilisons pas une moyenne simple. À la place, notre système tient compte de facteurs tels que l'ancienneté de l’avis et si le client ayant laissé un avis a acheté l'article sur Amazon. Les avis sont également analysés pour vérifier leur fiabilité."}function on(e){return"En savoir plus sur le fonctionnement des commentaires clients sur Amazon"}function rn(e){return"Comment fonctionnent les avis et les évaluations des clients"}function tn(e,n,i){return"Une note de "+n+" étoiles représente "+i+" % des évaluations"}function an(e,n){return"1 étoile représente "+n+" % des évaluations"}function dn(e){return"مراجعات المستخدمين، بما في ذلك تقييمات المنتج بالنجوم، تساعد العملاء على معرفة المزيد عن المنتج وتحديد ما إذا كان هذا هو المنتج المناسب لهم أم لا."}function sn(e){return"لحساب التقييم العام بالنجوم والنسبة المئوية حسب النجمة، نحن لا نستخدم متوسطًا بسيطًا. بدلًا من ذلك، يأخذ نظامنا في الاعتبار عوامل مثل مدى حداثة المراجعة وما إذا كان المُراجع قد اشترى السلعة من أمازون. كما يقوم أيضًا بتحليل التقييمات للتحقق من المصداقية."}function un(e){return"اكتشف المزيد حول كيفية عمل تقييمات المستخدمين على أمازون"}function cn(e){return"كيفية عمل مراجعات وتقييمات المستخدمين"}function ln(e,n,i){return"تمثل "+n+" نجوم "+i+"% من التقييمات"}function vn(e,n){return"تمثل نجمة واحدة "+n+"% من التقييمات"}function mn(e){return"Customer review, including product star rating help customer to learn more about the product and decide whether it is the right product for them."}function fn(e){return"To calculate the overall star rating and percentage breakdown by star, we don’t use a simple average. Instead, our system considers things like how recent a review is and whether the reviewer bought the item on Amazon. It also analysed reviews to verify trustworthiness."}function pn(e){return"Learn more how customer reviews work on Amazon"}function bn(e){return"How customer review and ratings work"}function hn(e,n,i){return n+" stars represent "+i+"% of ratings"}function gn(e,n){return"1 star represents "+n+"% of ratings"}function _n(e){return"পণ্যের স্টার রেটিংসহ গ্রাহক পর্যালোচনা গ্রাহকদের পণ্য সম্পর্কে আরও জানতে এবং এটি তাদের জন্য সঠিক কিনা তা সিদ্ধান্ত নিতে সহায়তা করে।"}function wn(e){return"সামগ্রিক স্টার রেটিং এবং স্টার অনুযায়ী শতাংশের হিসাব গণনায় আমরা সাধারণ গড় ব্যবহার করি না। বরং রিভিউটি কতটা সাম্প্রতিক এবং রিভিউকারী Amazon থেকে আইটেমটি কিনেছেন কিনা আমাদের সিস্টেম এ ধরণের বিষয় বিবেচনা করে। বিশ্বাসযোগ্যতা যাচাই করার জন্য এটি রিভিউগুলির বিশ্লেষণও করে।"}function zn(e){return"Amazon-এ গ্রাহক পর্যালোচনা কীভাবে কাজ করে তা আরও জানুন"}function kn(e){return"গ্রাহক পর্যালোচনা ও রেটিং কীভাবে কাজ করে"}function yn(e,n,i){return n+" স্টার "+i+"% রেটিংয়ের প্রতিনিধিত্ব করে"}function An(e,n){return"1 স্টার "+n+"% রেটিংয়ের প্রতিনিধিত্ব করে"}function In(e){return"상품의 별 평점을 포함한 고객 리뷰는 고객이 제품에 대해 자세히 알아보고 자신에게 적합한 제품인지 여부를 판단하는 데 도움이 됩니다."}function jn(e){return"전체 별 평점과 별 평점당 백분율 분석을 계산하기 위해 아마존은 단순한 평균값을 사용하지 않습니다. 대신 아마존 시스템은 리뷰가 얼마나 최신인지, 리뷰어가 아마존에서 해당 품목을 구매했는지 여부 등을 고려합니다. 또한 리뷰를 분석하여 신뢰성을 검증했습니다."}function Nn(e){return"아마존의 고객 리뷰 운영 방식 자세히 알아보기"}function En(e){return"고객 리뷰 및 평점 운영 방식"}function Sn(e,n,i){return"별점 "+n+"개는 평점의 "+i+"%를 차지합니다."}function Pn(e,n){return"별점 1개는 평점의 "+n+"%를 차지합니다."}function xn(e){return"Recenzje klientów, w tym oceny produktu w postaci gwiazdek, pomagają klientom dowiedzieć się więcej o produkcie i zdecydować, czy jest dla nich odpowiedni."}function Ln(e){return"Aby obliczyć ogólną ocenę gwiazdkową i podział procentowy według gwiazdek, nie używamy prostej średniej. Zamiast tego nasz system bierze pod uwagę takie elementy jak data recenzji oraz to, czy produkt został zakupiony na Amazon. Analizuje również recenzje w celu zweryfikowania wiarygodności."}function Cn(e){return"Dowiedz się więcej o działaniu recenzji klientów w Amazon"}function Rn(e){return"Jak działają recenzje i oceny klientów"}function Tn(e,n,i){return"Gwiazdki w liczbie "+n+" stanowią "+i+"% ocen"}function Hn(e,n){return"1 gwiazdka stanowi "+n+"% ocen"}function Bn(e){return"Customer review, including product star rating help customers to learn more about the product and decide whether it is the right product for them."}function On(e){return"To calculate the overall star rating and percentage breakdown by star, we don’t use a simple average. Instead, our system considers things like how recent a review is and if the reviewer bought the item on Amazon. It also analyses reviews to verify trustworthiness."}function Mn(e){return"Learn more how customer reviews work on Amazon"}function Kn(e){return"How customer review and rating work"}function Un(e,n,i){return n+" stars represent "+i+"% of ratings"}function Fn(e,n){return"1 star represents "+n+"% of ratings"}function Dn(e){return"Kundeanmeldelser, herunder klassificering af produkter med stjerner, giver kunderne mere information om produktet, så de kan afgøre, om det er det rigtige produkt for dem."}function Zn(e){return"For at beregne den samlede klassificering med stjerner og procentvise opdeling efter stjerne bruger vi ikke blot et simpelt gennemsnit. I stedet tager vores system højde for ting, som for eksempel hvor ny en anmeldelse er, og om anmelderen købte varen på Amazon. Det analyserer også anmeldelser for at kontrollere deres troværdighed."}function Gn(e){return"Lær mere, hvordan kundeanmeldelser fungerer på Amazon"}function Jn(e){return"Sådan fungerer kundeanmeldelser og vurderinger"}function qn(e,n,i){return n+" stjerner repræsenterer "+i+" % af bedømmelsen"}function Wn(e,n){return"1 stjerne repræsenterer "+n+"% af bedømmelserne"}function Vn(e){return"Klantenrecensies, inclusief sterbeoordelingen voor producten, geven klanten meer informatie over het product en helpen hen te beslissen of dit het juiste product voor ze is."}function Xn(e){return"Om de totale sterbeoordeling en de procentuele verdeling per ster te berekenen, gebruiken we geen gewoon gemiddelde. In plaats daarvan houdt ons systeem rekening met zaken als hoe recent een recensie is en of de recensent het item op Amazon heeft gekocht. Verder worden recensies ook geanalyseerd om de betrouwbaarheid te verifiëren."}function Yn(e){return"Meer informatie over hoe klantenrecensies werken op Amazon"}function Qn(e){return"Hoe klantenrecensies en -beoordelingen werken"}function $n(e,n,i){return n+" sterren vertegenwoordigen "+i+"% van de beoordelingen"}function ei(e,n){return"1 ster staat voor "+n+"% van de beoordelingen"}function ni(e){return"Les commentaires clients, y compris le nombre d’étoiles des produits, permettent aux acheteurs potentiels d’en savoir plus sur un produit et de déterminer s’il répond à leurs besoins."}function ii(e){return"Pour calculer l'évaluation par étoiles et la répartition en pourcentage par étoile, nous n'utilisons pas une moyenne simple. En effet, notre système prend en compte certains critères comme l'ancienneté d'un avis ou encore si l'auteur de cet avis a acheté l'article sur Amazon. De plus, il analyse les avis pour en vérifier la fiabilité."}function oi(e){return"En savoir plus sur le fonctionnement des commentaires clients sur Amazon"}function ri(e){return"Fonctionnement des avis et des évaluations des clients"}function ti(e,n,i){return n+" étoiles représentent le "+i+" % des évaluations"}function ai(e,n){return"1 étoile représente le "+n+" % des évaluations"}function di(e){return"Les commentaires clients, y compris les évaluations par étoiles des produits, aident les clients à obtenir plus d’informations sur le produit et à décider s’il s’agit du bon produit pour eux."}function si(e){return"Pour calculer l'évaluation globale par étoiles et la répartition en pourcentage par étoiles, nous ne nous basons pas sur le calcul d'une simple moyenne. Notre système prend plutôt en compte des éléments tels que le caractère récent d'un commentaire et le fait que l'auteur du commentaire ait acheté l'article sur Amazon. Il analyse également les commentaires pour vérifier leur fiabilité."}function ui(e){return"En savoir plus sur le fonctionnement des commentaires clients sur Amazon"}function ci(e){return"Comment fonctionnent les avis et les évaluations clients"}function li(e,n,i){return n+" étoiles représentent "+i+" % des notes"}function vi(e,n){return"1 étoile représente "+n+" % de la note"}function mi(e){return"தயாரிப்பு ஸ்டார் ரேட்டிங்குகள் உட்பட வாடிக்கையாளர் கருத்துகளானது தயாரிப்பு பற்றி வாடிக்கையாளர்கள் மேலும் அறியவும், அது அவர்களுக்கான சரியான தயாரிப்புதானா என்பதை முடிவுசெய்யவும் உதவும்."}function fi(e){return"ஒட்டுமொத்த ஸ்டார் ரேட்டிங் மற்றும் ஸ்டாரின்படி சதவீத பிரேக்டவுனைக் கணக்கிட, நாங்கள் எளிய சராசரியைப் பயன்படுத்த மாட்டோம். அதற்குப்பதிலாக, ஒரு கருத்து எவ்வளவு புதியது, கருத்து எழுதுபவர் Amazon இல் அந்தப் பொருளை வாங்கியிருக்கிறாரா என்பது போன்ற விஷயங்களை எங்கள் அமைப்பு கருத்தில் கொள்கிறது. இது கருத்துகளைப் பகுப்பாய்வு செய்து, அவற்றின் நம்பகத்தன்மையையும் உறுதிப்படுத்துகிறது."}function pi(e){return"Amazon இல் வாடிக்கையாளர் கருத்துகள் எவ்வாறு செயல்படுகின்றன என்பதைப் பற்றி மேலும் அறிக"}function bi(e){return"வாடிக்கையாளர் கருத்துகள் மற்றும் ரேட்டிங்குகள் செயல்படும் விதம்"}function hi(e,n,i){return"மதிப்பீடுகளில் "+n+"% ஐ "+i+" ஸ்டார்கள் குறிப்பிடுகின்றன"}function gi(e,n){return"மதிப்பீடுகளில் "+n+"% ஐ 1 ஸ்டார் குறிப்பிடுகிறது"}function _i(e){return"Kundenrezensionen, einschließlich Produkt-Sternebewertungen, helfen Kunden, mehr über das Produkt zu erfahren und zu entscheiden, ob es die richtige Wahl für sie ist."}function wi(e){return"Um die gesamte Sternebewertung und die prozentuale Aufschlüsselung nach Sternen zu berechnen, verwenden wir keinen einfachen Durchschnitt. Stattdessen betrachtet unser System Faktoren wie die Aktualität einer Rezension und ob der Rezensent den Artikel bei Amazon gekauft hat. Es wurden auch Bewertungen analysiert, um die Vertrauenswürdigkeit zu überprüfen."}function zi(e){return"Weitere Infos, wie Kundenrezensionen auf Amazon funktionieren"}function ki(e){return"So funktionieren Kundenrezensionen und Rezensionen"}function yi(e,n,i){return n+" Sterne entsprechen "+i+" % der Bewertungen"}function Ai(e,n){return"1 Stern entspricht "+n+" % der Bewertungen"}function Ii(e){return"ప్రొడక్ట్ స్టార్ రేటింగ్‌లతో సహా కస్టమర్ సమీక్షలు, ప్రొడక్ట్ గురించి మరింత తెలుసుకోవడానికి మరియు ఇది వారికి సరైన ప్రొడక్టా కాదా అని నిర్ణయించుకోవడానికి కస్టమర్‌లకు సహాయపడతాయి."}function ji(e){return"మొత్తం స్టార్ రేటింగ్ మరియు స్టార్‌ల వారీగా శాతం వివరాలను లెక్కించడానికి, మేము సాధారణ సగటును ఉపయోగించము. దీనికి బదులుగా, సమీక్ష ఎంత ఇటీవలిది మరియు సమీక్షకుడు ఆ వస్తువును Amazonలో కొనుగోలు చేశారా లేదా వంటి అంశాలను మా వ్యవస్థ పరిగణనలోకి తీసుకుంటుంది. ఇది విశ్వసనీయతను ధృవీకరించడానికి సమీక్షలను కూడా విశ్లేషించింది."}function Ni(e){return"Amazonలో కస్టమర్ సమీక్షలు ఎలా పనిచేస్తాయో మరింత తెలుసుకోండి"}function Ei(e){return"కస్టమర్ సమీక్షలు మరియు రేటింగ్‌లు ఎలా పని చేస్తాయి"}function Si(e,n,i){return n+" స్టార్‌లు రేటింగ్‌లో "+i+"%ని సూచిస్తాయి"}function Pi(e,n){return"1 స్టార్ "+n+"% రేటింగ్‌లను సూచిస్తుంది"}function xi(e){return"ביקורות לקוחות, כולל דירוגי כוכבים של מוצרים מסייעים ללקוחות ללמוד עוד על המוצר ולהחליט אם המוצר מתאים עבורם."}function Li(e){return"כדי לחשב את דירוג הכוכבים הכולל ואת התפלגות האחוזים לפי כוכב, אנחנו לא משתמשים בממוצע פשוט. במקום זאת, המערכת שלנו בוחנת דברים כמו עד כמה הביקורת חדשה והאם המבקר קנה את הפריט ב-Amazon. המערכת גם ניתחה ביקורות כדי לאמת מהימנות."}function Ci(e){return"למידע נוסף כיצד פועלות ביקורות של לקוחות ב-Amazon"}function Ri(e){return"איך עובדים דירוגים וביקורת לקוחות"}function Ti(e,n,i){return n+" כוכבים מייצגים %"+i+" מהדירוגים"}function Hi(e,n){return"כוכב אחד מייצג %"+n+" מהדירוגים"}function Bi(e){return"Kundeanmeldelser, inkludert produktstjernerangeringer, hjelper kundene med å finne ut mer om produktet og avgjøre om det er riktig produkt for dem."}function Oi(e){return"For å beregne den totale stjernerangeringen og prosentvis fordeling etter stjerne bruker vi ikke et enkelt gjennomsnitt. I stedet tar systemet vårt hensyn til ting som hvor nylig en anmeldelse er skrevet, og om anmelderen kjøpte varen på Amazon. Det analyserte også anmeldelser for å bekrefte hvor pålitelige de er."}function Mi(e){return"Finn ut mer om hvordan kundeanmeldelser fungerer på Amazon"}function Ki(e){return"Hvordan kundeanmeldelser og rangeringer fungerer"}function Ui(e,n,i){return n+" stjerner representerer "+i+" % av klassifiseringene"}function Fi(e,n){return"1 stjerne representerer "+n+" % av klassifiseringene"}function Di(e){return"customer review, including product star rating help customer to learn more about the product and decide whether it is the right product for them."}function Zi(e){return"To calculate the overall star rating and percentage breakdown by star, we don’t use a simple average. Instead, our system considers things like how recent a review is and if the reviewer bought the item on Amazon. It also analyzed reviews to verify trustworthiness."}function Gi(e){return"Learn more how customer reviews work on Amazon"}function Ji(e){return"How customer review and rating work"}function qi(e,n,i){return n+" stars represent "+i+"% of ratings"}function Wi(e,n){return"1 star represents "+n+"% of ratings"}function Vi(e){return"星の数を含む商品のカスタマーレビューは、お客様が商品についてより詳しく知り、それが自分にとって適切な商品であるかどうかを判断するのに役立ちます。"}function Xi(e){return"全体的な星の数と星ごとの割合の内訳を計算するにあたって、単純な平均は使用されません。 その代わり、レビューの日時がどれだけ新しいか、またレビューアーがAmazonで商品を購入したかどうかなどが考慮されます。 また、信頼性を検証するためにレビューが分析されます。"}function Yi(e){return"Amazonでのカスタマーレビューの仕組みについて詳しく知る"}function Qi(e){return"カスタマーレビューとレーティングの仕組み"}function $i(e,n,i){return"星"+n+"つは、レーティングの"+i+"%を表します"}function eo(e,n){return"星1つは、レーティングの"+n+"%を表します"}function no(e){return"Kundrecensioner, inklusive stjärnrecensioner av produkter, hjälper kunder att lära sig mer om produkten och avgöra om det är rätt produkt för dem."}function io(e){return"Vi använder inte ett enkelt medelvärde för att beräkna det totala stjärnbetyget och den procentuella fördelningen per stjärna. I stället tar vårt system hänsyn till saker som till exempel hur nyligen en recension har gjorts och om recensenten köpte artikeln på Amazon. Systemet analyserar också recensioner för att verifiera deras trovärdighet."}function oo(e){return"Läs mer om hur kundrecensioner fungerar på Amazon"}function ro(e){return"Hur kundrecensioner och betyg fungerar"}function to(e,n,i){return n+" stjärnor motsvarar "+i+" % av betygen"}function ao(e,n){return"1 stjärna motsvarar "+n+" % av betygen"}function so(e){return"Customer reviews, including product star ratings help customer to learn more about the product and decide whether it is the right product for them."}function uo(e){return"To calculate the overall star rating and percentage breakdown by star, we don’t use a simple average. Instead, our system considers things like how recent a review is and if the reviewer bought the item on Amazon. It also analysed reviews to verify trustworthiness."}function co(e){return"Learn more how customer reviews work on Amazon"}function lo(e){return"How customer review and ratings work"}function vo(e,n,i){return n+" stars represent "+i+"% of ratings"}function mo(e,n){return"1 star represents "+n+"% of ratings"}function fo(e){return"ग्राहकाची परीक्षणे, तसेच प्रॉडक्टची स्टार रेटिंग्स ही ग्राहकांना उत्पादनाबद्दल अधिक जाणून घेण्यास आणि त्यांच्यासाठी ते योग्य उत्पादन आहे की नाही हे ठरविण्यात मदत करतात."}function po(e){return"एकूण स्टार रेटिंग आणि स्टारनुसार टक्केवारीचे ब्रेकडाउन मोजण्यासाठी, आम्ही साधी सरासरी वापरत नाही. त्याऐवजी, आमचे सिस्टम परीक्षण किती अलीकडील आहे आणि परीक्षणकर्त्याने Amazon वर आयटम विकत घेतला की नाही यासारख्या गोष्टींचा विचार करते. विश्वासार्हतेचे सत्यापन करण्यासाठी परीक्षणांचे विश्लेषण देखील केले."}function bo(e){return"Amazon वर ग्राहकाचे परीक्षण कसे कार्य करते ते अधिक जाणून घ्या"}function ho(e){return"ग्राहकाची परीक्षणे आणि रेटिंग्ज कसे कार्य करतात"}function go(e,n,i){return n+" स्टार्स "+i+"% रेटिंगचे प्रतिनिधित्व करतात"}function _o(e,n){return"1 स्टार "+n+" % रेटिंगचे प्रतिनिधित्व करते"}function wo(e){return"ग्राहक की समीक्षाएं जिसमें प्रोडक्ट स्टार रेटिंग भी शामिल है, ग्राहकों को प्रोडक्ट के बारे में और अधिक जानने और यह फ़ैसला लेने में मदद करती हैं कि यह उनके लिए सही प्रोडक्ट है या नहीं."}function zo(e){return"कुल स्टार रेटिंग और स्टार के हिसाब से प्रतिशत का हिसाब लगाने के लिए, हम साधारण औसत का इस्तेमाल नहीं करते हैं. इसके बजाय, हमारा सिस्टम उन चीज़ों पर विचार करता है, जैसे कि समीक्षा कितनी हाल की है और क्या समीक्षक ने Amazon पर आइटम खरीदा है। इसने विश्वसनीयता को सत्यापित करने के लिए समीक्षाओं का विश्लेषण भी किया।"}function ko(e){return"Amazon पर ग्राहकों की समीक्षाएं कैसे काम करती हैं इस बारे में और जानें"}function yo(e){return"ग्राहक की समीक्षा और रेटिंग कैसे काम करती हैं"}function Ao(e,n,i){return n+" स्टार रेटिंग का "+i+"% दर्शाते हैं"}function Io(e,n){return"1 स्टार "+n+"% रेटिंग को दर्शाता है"}function jo(e){return"Las opiniones de los clientes, incluidas las valoraciones de los productos, ayudan a los clientes a conocer más acerca del producto y a decidir si es adecuado para ellos."}function No(e){return"Para calcular la calificación general por estrellas y el desglose porcentual por estrella, no usamos un promedio simple. En cambio, nuestro sistema toma en cuenta aspectos como la antigüedad de una reseña y si la persona que la escribió compró el producto en Amazon. También se analizan las opiniones para verificar la confiabilidad."}function Eo(e){return"Más información sobre cómo funciona la opinión del cliente en Amazon"}function So(e){return"Cómo funcionan las opiniones y las calificaciones de clientes"}function Po(e,n,i){return n+" estrellas representan "+i+"% de la valoración"}function xo(e,n){return"1 estrella representa "+n+"% de la valoración"}function Lo(n){var i,o=a.bind(void 0,void 0===n?{}:n),r=v.bind(void 0,void 0===n?{}:n),t=g.bind(void 0,void 0===n?{}:n),d=A.bind(void 0,void 0===n?{}:n),s=P.bind(void 0,void 0===n?{}:n),u=H.bind(void 0,void 0===n?{}:n),c=F.bind(void 0,void 0===n?{}:n),l=W.bind(void 0,void 0===n?{}:n),m=ee.bind(void 0,void 0===n?{}:n),f=ae.bind(void 0,void 0===n?{}:n),p=ve.bind(void 0,void 0===n?{}:n),b=ge.bind(void 0,void 0===n?{}:n),h=Ae.bind(void 0,void 0===n?{}:n),_=Pe.bind(void 0,void 0===n?{}:n),w=He.bind(void 0,void 0===n?{}:n),z=Fe.bind(void 0,void 0===n?{}:n),k=We.bind(void 0,void 0===n?{}:n),y=en.bind(void 0,void 0===n?{}:n),I=dn.bind(void 0,void 0===n?{}:n),j=mn.bind(void 0,void 0===n?{}:n),N=_n.bind(void 0,void 0===n?{}:n),E=In.bind(void 0,void 0===n?{}:n),S=xn.bind(void 0,void 0===n?{}:n),x=Bn.bind(void 0,void 0=