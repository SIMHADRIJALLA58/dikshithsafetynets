        }

        .dpx-insights-multi-row-carousel.follow-up-row {
            margin-top: 0px;
        }

        .dpx-insights-multi-row-carousel-card img {
            vertical-align: middle;
            position: relative;
            top: -1px;
        }

        .dpx-insights-multi-row-carousel-card:has(img) {
            margin-right: 0px;
            vertical-align: middle;
        }

        .dpx-insights-multi-row-carousel-card {
            align-items: center;
            letter-spacing: normal;
            list-style-image: none;
            list-style-position: outside;
            list-style-type: none;
            margin: 0 6px 0 0;
            min-height: 100%;
            overflow-wrap: break-word;
            overflow-x: clip;
            overflow-y: clip;
            position: relative;
            text-align: left;
        }

        .dpx-insights-multi-row-carousel-label {
            color: var(--aok-sfs-color-page-secondary-normal-fg, #565959);
            font-weight: 400;
            font-size: 14px;
            line-height: 18px;
            margin-right: 4px; /* Override the default 6px margin */
        }

        .dpx-insights-pill-wrapper {
            align-items: flex-start;
            display: flex;
            line-height: 20px;
            margin-right: 0;
            width: 100%;
        }

        .dpx-insights-tick-container {
            flex: 0 0 auto;
            padding-top: 2px;
        }

        .dpx-insights-pill-content {
            flex: 1;
            min-width: 0;
        }

        .dpx-insights-pill-content > * {
            word-wrap: break-word;
            word-break: normal;
            overflow-wrap: break-word;
            width: 100%;
        }

        .dpx-insights-multi-row-carousel.follow-up-row {
            line-height: 20px;
        }

        #dpx-insights-desktop .dpx-insights-top-highlights-heading {
            color: var(--aok-sfs-color-page-primary-normal-fg, #0F1111);
            font-family: "Amazon Ember", Arial, sans-serif;
            font-size: 20px;
            font-weight: 700;
            line-height: 24px;
            margin: 0 0 8px;
            padding: 0;
        }

        .dpx-insights-widget-info {
            display: flex;
            line-height: 18px;
            margin-bottom: 4px;
        }
    </style>

</div>                       </div>
